@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam BackgroundColor white
skinparam usecaseBackgroundColor white
skinparam actorBackgroundColor white
actor "Manager / ketenregisseur" as manager
actor "Directeur / eigenaar" as directeur
actor "Importcoördinator" as importCoordinator
actor "Magazijnmedewerker" as magazijn
actor "Printz-medewerker" as printz
actor "DHL-medewerker" as dhl
actor "Klantenservice / accountmanager" as service
actor "Klant (B2B / B2C)" as klant
actor "Leveranciersmedewerker Hongkong" as leverancier
rectangle "GIFTS4U-platform inclusief Control Tower" {
  usecase "Ketenoverzicht\nraadplegen (UC01)" as UC01
  usecase "Uitzonderingen en\nimpact beoordelen (UC02)\n--\nUitbreidingspunt\nHerstelopties gewenst" as UC02
  usecase "Corrigerend besluit\nvastleggen en toewijzen (UC03)" as UC03
  usecase "Besluit en opvolging\ncontroleren (UC04)" as UC04
  usecase "Importpartijen\nregistreren en volgen (UC05)" as UC05
  usecase "Importvertraging\nregistreren (UC06)" as UC06
  usecase "Voorraad ontvangen,\nplannen en reserveren (UC07)" as UC07
  usecase "Overdracht naar\nPrintz bevestigen (UC08)" as UC08
  usecase "Printopdracht uitvoeren\nen kwaliteit vrijgeven (UC09)" as UC09
  usecase "Printstoring of\ncapaciteitstekort melden (UC10)" as UC10
  usecase "Zending volgen en\ngebeurtenissen bevestigen (UC11)" as UC11
  usecase "Transportcapaciteit\nplannen (UC12)" as UC12
  usecase "Klantupdate opstellen\nen afhandeling vastleggen (UC13)" as UC13
  usecase "Personalisatieklacht\nregistreren en opvolgen (UC14)" as UC14
  usecase "Bestelling plaatsen\nmet personalisatie (UC15)" as UC15
  usecase "Orderupdates\nontvangen (UC16)" as UC16
  usecase "Herstelopties vergelijken" as herstel
  usecase "Voorraad controleren" as voorraad
}
manager -- UC01
manager -- UC02
UC03 -- directeur
UC04 -- directeur
importCoordinator -- UC05
importCoordinator -- UC06
magazijn -- UC07
magazijn -- UC08
UC09 -- printz
UC10 -- printz
UC11 -- dhl
UC12 -- dhl
UC13 -- service
UC14 -- service
klant -- UC15
klant -- UC16
leverancier -- UC05
herstel ..> UC02 : <<extend>>\n[herstelopties gewenst]
UC15 ..> voorraad : <<include>>
@enduml
