@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam usecase {
  BackgroundColor #F0EBFE
  BorderColor #7855E9
}
title GIFTS4U Control Tower — één beheerder
actor "Control Tower-beheerder" as beheerder
rectangle "GIFTS4U Control Tower" {
  usecase "UC01\nOrderoverzicht\nRaadplegen" as UC01
  usecase "UC02\nUitzonderingen En\nImpact Beoordelen" as UC02
  usecase "UC03\nCorrigerend Besluit\nVastleggen En Toewijzen" as UC03
  usecase "UC04\nOpvolging En Logboek\nRaadplegen" as UC04
  usecase "UC05\nVoorraad En Import\nVolgen" as UC05
  usecase "UC06\nProductie En Transport\nVolgen" as UC06
  usecase "UC07\nKlantcommunicatie\nCoördineren" as UC07
  usecase "UC08\nKPI's En Meldingen\nBewaken" as UC08
}
beheerder -- UC01
beheerder -- UC02
beheerder -- UC03
beheerder -- UC04
beheerder -- UC05
beheerder -- UC06
beheerder -- UC07
beheerder -- UC08
@enduml
